{
    "name": "Status Lamp Addon",
    "version": "1.0.0",
    "id": "de.busch-jaeger.freeathome.statuslamp",
    "license": "MIT",
    "description": "Nimmt einen Dimmwert (0–100) entgegen und setzt eine echte RGB-Lampe farblich: grün → gelb → rot",
    "url": "https://www.busch-jaeger.de",
    "author": "Busch Jaeger",
    "type": "app",
    "entryPoint": "build/main.js",
    "parameters": {
        "default": {
            "name": "Einstellungen",
            "items": {
                "targetLamp": {
                    "name": "Statuslampe (RGB-Kanal)",
                    "type": "channel",
                    "filters": [
                        { "type": "FID_RGB_ACTUATOR" },
                        { "type": "FID_RGB_W_ACTUATOR" },
                        { "type": "FID_DALI_DT8_RGB_ACTUATOR" },
                        { "type": "FID_RGB_ACTUATOR_TYPE8" },
                        { "type": "FID_RGB_W_ACTUATOR_TYPE8" }
                    ]
                }
            }
        }
    }
}
