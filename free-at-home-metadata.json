{
    "name": "Status Lamp Addon",
    "version": "1.0.0",
    "id": "de.busch-jaeger.freeathome.statuslamp",
    "license": "MIT",
    "description": "Addiert mehrere Dimmwerte und setzt eine RGB-Statuslampe entsprechend der Summe (grün → gelb → rot)",
    "url": "https://www.busch-jaeger.de",
    "author": "Busch Jaeger",
    "type": "app",
    "entryPoint": "build/main.js",
    "parameters": {
        "default": {
            "name": "Einstellungen",
            "items": {
                "numberOfInputs": {
                    "name": "Anzahl Eingänge",
                    "type": "number",
                    "min": 1,
                    "max": 10
                },
                "yellowThreshold": {
                    "name": "Gelb-Schwelle (%)",
                    "type": "number",
                    "min": 0,
                    "max": 100
                },
                "redThreshold": {
                    "name": "Rot-Schwelle (%)",
                    "type": "number",
                    "min": 0,
                    "max": 100
                }
            }
        }
    }
}
