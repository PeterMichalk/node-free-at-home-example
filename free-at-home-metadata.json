{
    "name": "Status Lamp Addon",
    "version": "1.0.0",
    "id": "de.busch-jaeger.freeathome.statuslamp",
    "license": "MIT",
    "description": "Addiert/Subtrahiert Werte und setzt eine virtuelle RGB-Statuslampe in 4 konfigurierbaren Farben. Die virtuelle Lampe mit der echten Lampe im free@home App verknüpfen.",
    "url": "https://www.busch-jaeger.de",
    "author": "Busch Jaeger",
    "type": "app",
    "entryPoint": "build/main.js",
    "parameters": {
        "default": {
            "name": "Einstellungen",
            "items": {
                "threshold1": {
                    "name": "Schwelle Zone 1→2",
                    "type": "number",
                    "min": 0,
                    "max": 9999,
                    "default": 25
                },
                "threshold2": {
                    "name": "Schwelle Zone 2→3",
                    "type": "number",
                    "min": 0,
                    "max": 9999,
                    "default": 50
                },
                "threshold3": {
                    "name": "Schwelle Zone 3→4",
                    "type": "number",
                    "min": 0,
                    "max": 9999,
                    "default": 75
                },
                "color1Hue": {
                    "name": "Farbe Zone 1 – Farbton (0–360°)",
                    "type": "number",
                    "min": 0,
                    "max": 360,
                    "default": 120
                },
                "color2Hue": {
                    "name": "Farbe Zone 2 – Farbton (0–360°)",
                    "type": "number",
                    "min": 0,
                    "max": 360,
                    "default": 60
                },
                "color3Hue": {
                    "name": "Farbe Zone 3 – Farbton (0–360°)",
                    "type": "number",
                    "min": 0,
                    "max": 360,
                    "default": 30
                },
                "color4Hue": {
                    "name": "Farbe Zone 4 – Farbton (0–360°)",
                    "type": "number",
                    "min": 0,
                    "max": 360,
                    "default": 0
                }
            }
        }
    }
}
