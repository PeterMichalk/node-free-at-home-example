{
  "name": "Powerfox Stromzähler für free@home",
  "version": "1.0.0",
  "id": "de.busch-jaeger.freeathome.powerfox",
  "license": "MIT",
  "description": "Bindet den powerfox Poweropti Stromzähler über die powerfox Kunden-API in free@home ein.",
  "url": "https://powerfox.energy",
  "author": "free@home powerfox integration",
  "type": "app",
  "entryPoint": "build/main.js",
  "accessControl": {
      "networkAccess": true,
      "networkPorts": [443]
  },
  "parameters": {
      "default": {
          "name": "Einstellungen",
          "items": {
              "email": {
                  "name": "powerfox E-Mail",
                  "type": "string"
              },
              "password": {
                  "name": "powerfox Passwort",
                  "type": "password"
              },
              "pollIntervalSeconds": {
                  "name": "Abfrageintervall (Sekunden)",
                  "type": "number",
                  "min": 10,
                  "max": 3600,
                  "default": 30
              }
          }
      }
  }
}
