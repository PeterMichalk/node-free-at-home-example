{
    "name": "Status Lamp Addon",
    "version": "1.0.0",
    "id": "de.busch-jaeger.freeathome.statuslamp",
    "license": "MIT",
    "description": "Zwei Dimm-Aktoren (Addieren / Subtrahieren) steuern per Nettowert eine echte RGB-Lampe in 4 konfigurierbaren Farben",
    "url": "https://www.busch-jaeger.de",
    "author": "Busch Jaeger",
    "type": "app",
    "entryPoint": "build/main.js",
    "parameters": {
        "default": {
            "name": "Einstellungen",
            "items": {
                "targetLamp": {
                    "name": "Statuslampe (RGB-Kanal)",
                    "type": "channel",
                    "filters": [
                        { "type": "FID_RGB_ACTUATOR" },
                        { "type": "FID_RGB_W_ACTUATOR" },
                        { "type": "FID_DALI_DT8_RGB_ACTUATOR" },
                        { "type": "FID_RGB_ACTUATOR_TYPE8" },
                        { "type": "FID_RGB_W_ACTUATOR_TYPE8" }
                    ]
                },
                "threshold1": {
                    "name": "Schwelle Zone 1→2 (0–100)",
                    "type": "number",
                    "min": 0,
                    "max": 100,
                    "default": 25
                },
                "threshold2": {
                    "name": "Schwelle Zone 2→3 (0–100)",
                    "type": "number",
                    "min": 0,
                    "max": 100,
                    "default": 50
                },
                "threshold3": {
                    "name": "Schwelle Zone 3→4 (0–100)",
                    "type": "number",
                    "min": 0,
                    "max": 100,
                    "default": 75
                },
                "color1Hue": {
                    "name": "Farbe Zone 1 – Farbton (0–360°)",
                    "type": "number",
                    "min": 0,
                    "max": 360,
                    "default": 120
                },
                "color2Hue": {
                    "name": "Farbe Zone 2 – Farbton (0–360°)",
                    "type": "number",
                    "min": 0,
                    "max": 360,
                    "default": 60
                },
                "color3Hue": {
                    "name": "Farbe Zone 3 – Farbton (0–360°)",
                    "type": "number",
                    "min": 0,
                    "max": 360,
                    "default": 30
                },
                "color4Hue": {
                    "name": "Farbe Zone 4 – Farbton (0–360°)",
                    "type": "number",
                    "min": 0,
                    "max": 360,
                    "default": 0
                }
            }
        }
    }
}
